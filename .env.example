# 設定しなくても公開デモとして起動できます。
PITADAY_MODE=demo
PITADAY_ENABLE_PUSH=false

# 独立したFirebaseプロジェクトで検証する際のWeb設定。
# 元の開発・本番環境の値や管理者秘密鍵は入れないでください。
# firebaseへ切り替えても公開版のアクセスルールは全拒否です。
PITADAY_FIREBASE_API_KEY=
PITADAY_FIREBASE_AUTH_DOMAIN=
PITADAY_FIREBASE_PROJECT_ID=
PITADAY_FIREBASE_STORAGE_BUCKET=
PITADAY_FIREBASE_MESSAGING_SENDER_ID=
PITADAY_FIREBASE_APP_ID=
PITADAY_VAPID_KEY=
